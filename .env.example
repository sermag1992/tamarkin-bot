# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ID канала: числовой вида -100... или @username
TELEGRAM_CHANNEL_ID=@tamarkin_marketing

# RSS-ленты через запятую
RSS_URLS=https://vc.ru/rss/all,https://habr.com/ru/rss/news/?fl=ru

# rss — обложка статьи из ленты, иначе Pollinations | pollinations — генерация всегда | openai — нужен ключ
IMAGE_MODE=rss

# Ключ OpenAI, нужен только при IMAGE_MODE=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024

# Как часто проверять новости, в минутах (0 = один прогон и выход — для CI/хостинга)
CHECK_INTERVAL_MINUTES=60

# Базовый адрес Telegram Bot API (менять только если есть свой релей)
TELEGRAM_API_BASE=https://api.telegram.org

# Свежесть новостей, в часах
MAX_NEWS_AGE_HOURS=24

POSTED_JSON_PATH=posted.json
LOG_LEVEL=INFO
